      {"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" session-start codex", "timeout": 5}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" subagent-start codex", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" subagent-stop codex", "timeout": 5}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "\"$PLUGIN_ROOT/scripts/hook.sh\" pre-compact codex", "timeout": 5}]}
    ]
  }
}
