#!/bin/sh
# fox, as the foxdb Claude Code plugin puts it on the Bash tool's PATH and runs it as the MCP
# server: runs the installed fox in ${FOXDB_HOME:-$HOME/.foxdb}/bin. The plugin ships no binary.
fox=${FOXDB_HOME:-$HOME/.foxdb}/bin/fox
[ -x "$fox" ] && exec "$fox" "$@"
cat >&2 <<EOF
foxdb: fox is not installed at $fox.
Install it (no root, no login), then restart the session:
  curl -fsSL https://raw.githubusercontent.com/ManavA/foxdb/main/scripts/install.sh | sh
or from a clone: git clone https://github.com/ManavA/foxdb.git && foxdb/scripts/install.sh
EOF
exit 127
