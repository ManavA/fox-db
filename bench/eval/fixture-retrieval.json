{
 "name": "fixture-retrieval",
 "repo": "bench/eval/fixture",
 "about": "A small checked-in corpus (bench/eval/fixture) run by `cargo test` on every change: questions in words, code vocabulary and bare identifiers, each with one target symbol.",
 "queries": [
  {
   "id": "v01",
   "type": "vague",
   "q": "make a request body readable again so it can be sent a second time",
